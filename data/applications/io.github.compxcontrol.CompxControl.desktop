[Desktop Entry]
Type=Application
Name=Compx Control
GenericName=Mouse Configuration
Comment=Configure COMPX-based mice and show battery in the tray
Exec=compx-control
Icon=compx-control
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=mouse;gaming;dpi;polling;battery;MAD R;VXE;ATK;COMPX;
StartupNotify=true
StartupWMClass=compx-control
X-GNOME-UsesNotifications=true
